# =========================================================================
# GitPilot Root Environment Variables Reference Template
# Copy this to .env (do NOT check .env into Git) and populate values
# =========================================================================

# Database Configuration (Spring Boot Backend)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gitpilot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# GitHub OAuth App Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Webhook HMAC signature key
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# AI Gateway API keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
