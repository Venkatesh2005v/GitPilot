# =========================================================================
# GitPilot Backend Environment Variables Template
# Copy this to application-secrets.properties inside backend/src/main/resources/
# =========================================================================

# Database Connection Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gitpilot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# GitHub OAuth Login
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Webhooks Secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# AI Gateway Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
