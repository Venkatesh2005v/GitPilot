# =========================================================================
# GitPilot Frontend Environment Settings
# The React SPA communicates with the backend via proxied same-origin API routes,
# meaning no backend keys or OAuth credentials are exposed to the client.
# =========================================================================

# Vite development server port
PORT=5173
# -------------------------------------------------------------------------
# API base URL for the backend.
# LOCAL DEVELOPMENT: leave this UNSET/empty. The app then uses relative API
#   paths and the Vite dev proxy (see vite.config.js) forwards them to the
#   local backend at http://localhost:8080. Local behavior is unchanged.
# PRODUCTION (Vercel): set this to the deployed Render backend origin, e.g.
#   VITE_API_BASE_URL=https://your-backend.onrender.com
# Do NOT put secrets here; this is a public client-side value.
# -------------------------------------------------------------------------
# VITE_API_BASE_URL=
